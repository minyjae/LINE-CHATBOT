# App
APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080
APP_PREFIX=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
# When running with Docker Compose, DB_HOST is overridden to "postgres" for the api container.
DB_HOST=localhost
DB_PORT=5432
DB_USER=line_chatbot
DB_PASSWORD=line_chatbot_password
DB_NAME=line_chatbot
DB_SSL=disable

# JWT
# Use a strong random value in production. Production requires at least 32 characters.
JWT_SECRET=change-me-to-a-random-32-character-secret
JWT_EXPIRES_IN=24

# LINE Messaging API
# Required in production. In development, empty values let local webhook tests run without LINE calls.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# OpenAI Intent Parser
# If OPENAI_API_KEY is empty, the assistant falls back to the rule-based parser.
OPENAI_API_KEY=
OPENAI_INTENT_MODEL=gpt-5

# Reminder Worker
REMINDER_WORKER_ENABLED=false
REMINDER_WORKER_INTERVAL_SECONDS=60
REMINDER_WORKER_BATCH_SIZE=50

# Migration
AUTO_MIGRATE=true

# Admin
# Required in production.
ADMIN_EMAIL=admin@example.com

# pgAdmin (Docker Compose)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5051

# Docker Compose compatibility
SECRET_KEY=change-me
